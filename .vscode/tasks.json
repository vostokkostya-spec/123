{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test: orchestration",
      "type": "shell",
      "command": "npm.cmd test",
      "problemMatcher": []
    },
    {
      "label": "diagnose: Ollama",
      "type": "shell",
      "command": "node src/index.js ollama-status",
      "problemMatcher": []
    },
    {
      "label": "diagnose: project",
      "type": "shell",
      "command": "node src/index.js --diagnose",
      "problemMatcher": []
    },
    {
      "label": "smoke: keyword route",
      "type": "shell",
      "command": "node src/index.js route \"Fix the login bug\"",
      "problemMatcher": []
    },
    {
      "label": "smoke: forced LLM route",
      "type": "shell",
      "command": "node src/index.js route \"How should we organize the project release?\" --llm",
      "problemMatcher": []
    },
    {
      "label": "coder: propose file change",
      "type": "shell",
      "command": "node src/index.js code \"${input:coderTask}\" --file ${input:coderFile}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "coderTask",
      "type": "promptString",
      "description": "Task for the coder agent"
    },
    {
      "id": "coderFile",
      "type": "promptString",
      "description": "Workspace-relative file path"
    }
  ]
}
